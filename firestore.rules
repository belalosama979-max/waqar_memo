rules_version = '2';

// Security model for "الوقار" (Firebase free Spark plan — no Cloud Functions).
//
// Every signed-in account has a profile at users/{authUid}:
//   { role: 'admin' | 'teacher', active, mustChangePassword,
//     teacherId (teachers only), departmentId ('male' | 'female', teachers only) }
// Roles are therefore read from that document. Only an admin can create or
// change another account's profile, and the very first admin is created once
// through the bootstrap document app_settings/bootstrap.
//
// A teacher's identity (teachers/{teacherId}) is separate from the login account,
// so an admin "password reset" issues a new login linked to the same teacher.
//
// Department isolation is enforced here, never by client-side filtering.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function me() { return get(docPath('users', request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(docPath('users', request.auth.uid)); }
    function isAdmin() { return hasProfile() && me().role == 'admin' && me().active == true; }
    // A teacher still holding a temporary password can read only their own
    // profile until they set a new password.
    function isTeacher() {
      return hasProfile()
        && me().role == 'teacher'
        && me().active == true
        && me().mustChangePassword == false
        && me().departmentId in ['male', 'female']
        && me().teacherId is string;
    }
    function dept() { return me().departmentId; }
    function myTeacherId() { return me().teacherId; }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validDept(d) { return d in ['male', 'female']; }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 60; }
    function optionalString(m, k, max) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= max); }

    function evaluationNames() { return ['excellentPlus', 'excellent', 'veryGood', 'notRecited', 'repeat']; }
    function defaultPoints() {
      return { 'excellentPlus': 60, 'excellent': 40, 'veryGood': 25, 'notRecited': 0, 'repeat': 10 };
    }

    function bootstrapPath() { return docPath('app_settings', 'bootstrap'); }

    // ---------- users (private profile) ----------
    function userKeys() {
      return ['role', 'displayName', 'departmentId', 'teacherId', 'active', 'mustChangePassword',
              'email', 'createdAt', 'passwordChangedAt', 'fcmTokens', 'replacedAt'];
    }

    // First-run setup: the first signed-in user may make themselves admin,
    // atomically with creating app_settings/bootstrap. Afterwards this is closed.
    function bootstrapsAdmin(uid) {
      return request.auth.uid == uid
        && !exists(bootstrapPath())
        && getAfter(bootstrapPath()).data.adminUid == uid
        && incoming().keys().hasOnly(userKeys())
        && incoming().role == 'admin'
        && incoming().active == true
        && incoming().mustChangePassword == false
        && validName(incoming().displayName);
    }

    // An admin creates the login profile of a teacher (temporary password).
    function adminCreatesTeacherLogin() {
      let u = incoming();
      let t = getAfter(docPath('teachers', u.teacherId));
      return isAdmin()
        && u.keys().hasOnly(userKeys())
        && u.role == 'teacher'
        && u.teacherId is string
        && t != null
        && t.data.departmentId == u.departmentId
        && validName(u.displayName)
        && u.active == true
        && u.mustChangePassword == true;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if bootstrapsAdmin(uid) || adminCreatesTeacherLogin();
      // Self: finish the first-login password change, manage device ids.
      // Admin: activate/deactivate, rename, move department, retire a login.
      allow update: if (signedIn() && request.auth.uid == uid
                        && changedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt', 'fcmTokens'])
                        && (!('mustChangePassword' in changedKeys()) || incoming().mustChangePassword == false)
                        && (!('passwordChangedAt' in changedKeys()) || incoming().passwordChangedAt == request.time)
                        && (!('fcmTokens' in changedKeys())
                            || (incoming().fcmTokens is list && incoming().fcmTokens.size() <= 10)))
                    || (isAdmin() && request.auth.uid != uid
                        && changedKeys().hasOnly(['active', 'displayName', 'departmentId', 'replacedAt'])
                        && validName(incoming().displayName)
                        && (incoming().departmentId == null || validDept(incoming().departmentId)));
      allow delete: if false;
    }

    match /app_settings/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && incoming().keys().hasOnly(['adminUid', 'createdAt'])
        && incoming().adminUid == request.auth.uid
        && incoming().createdAt == request.time
        && getAfter(docPath('users', request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    // ---------- public login directory (names only) ----------
    match /login_directory/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.method == 'delete'
            || (incoming().keys().hasOnly(['displayName', 'departmentId', 'authEmail', 'active'])
                && validName(incoming().displayName)
                && validDept(incoming().departmentId)
                && incoming().authEmail is string
                && incoming().active is bool));
    }

    match /departments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- teachers ----------
    function teacherKeys() { return ['displayName', 'departmentId', 'active', 'studentCount', 'phone', 'authUid', 'createdAt', 'updatedAt']; }

    match /teachers/{tid} {
      allow read: if isAdmin() || (isTeacher() && resource.data.departmentId == dept());
      allow create: if isAdmin()
        && incoming().keys().hasOnly(teacherKeys())
        && validName(incoming().displayName)
        && validDept(incoming().departmentId)
        && incoming().active == true
        && incoming().studentCount == 0
        && optionalString(incoming(), 'phone', 30);
      allow update: if isAdmin()
        && incoming().keys().hasOnly(teacherKeys())
        && validName(incoming().displayName)
        && validDept(incoming().departmentId)
        && incoming().studentCount is int && incoming().studentCount >= 0
        && optionalString(incoming(), 'phone', 30)
        // A teacher with students cannot switch department (transfer them first).
        && (!('departmentId' in changedKeys()) || existing().studentCount == 0);
      allow delete: if isAdmin() && existing().studentCount == 0;
    }

    // ---------- students ----------
    function studentKeys() {
      return ['fullName', 'searchName', 'teacherId', 'teacherName', 'departmentId', 'totalPoints',
              'recitationCount', 'guardianPhone', 'notes', 'joinedAt', 'createdAt', 'updatedAt',
              'lastRecitationId', 'lastRecitationLabel', 'lastRecitationDate', 'lastEvaluation',
              'lastAppliedRecitationId', 'previousTeacherIds', 'transferredAt'];
    }

    function teacherMatches(data) {
      let t = getAfter(docPath('teachers', data.teacherId));
      return t != null && t.data.departmentId == data.departmentId && t.data.active == true;
    }

    function validStudentCreate() {
      let s = incoming();
      return s.keys().hasOnly(studentKeys())
        && s.keys().hasAll(['fullName', 'teacherId', 'teacherName', 'departmentId', 'totalPoints', 'recitationCount'])
        && validName(s.fullName)
        && validDept(s.departmentId)
        && s.totalPoints == 0 && s.recitationCount == 0
        && optionalString(s, 'guardianPhone', 30)
        && optionalString(s, 'notes', 300)
        && teacherMatches(s);
    }

    function validStudentAdminUpdate() {
      let s = incoming();
      return s.keys().hasOnly(studentKeys())
        && validName(s.fullName)
        && validDept(s.departmentId)
        && s.totalPoints is int && s.recitationCount is int && s.recitationCount >= 0
        && optionalString(s, 'guardianPhone', 30)
        && optionalString(s, 'notes', 300)
        && (!('teacherId' in changedKeys()) || teacherMatches(s));
    }

    // A teacher may only change a student's aggregate in the SAME batch that
    // creates a new recitation for that student, by exactly that recitation's points.
    function teacherAppliesRecitation(sid) {
      let rid = incoming().lastAppliedRecitationId;
      let after = getAfter(docPath('recitations', rid));
      return existing().teacherId == myTeacherId()
        && existing().departmentId == dept()
        && changedKeys().hasOnly(['totalPoints', 'recitationCount', 'lastAppliedRecitationId', 'updatedAt',
                                  'lastRecitationId', 'lastRecitationLabel', 'lastRecitationDate', 'lastEvaluation'])
        && rid is string
        && !exists(docPath('recitations', rid))
        && after != null
        && after.data.studentId == sid
        && incoming().totalPoints == existing().totalPoints + after.data.totalPoints
        && incoming().recitationCount == existing().recitationCount + 1
        && incoming().updatedAt == request.time
        && (!('lastRecitationId' in changedKeys()) || incoming().lastRecitationId == rid)
        && (!('lastEvaluation' in changedKeys()) || incoming().lastEvaluation == after.data.evaluation)
        && (!('lastRecitationDate' in changedKeys()) || incoming().lastRecitationDate == after.data.recitationDate)
        && (!('lastRecitationLabel' in changedKeys()) || (incoming().lastRecitationLabel is string && incoming().lastRecitationLabel.size() <= 60));
    }

    match /students/{sid} {
      allow read: if isAdmin() || (isTeacher() && resource.data.departmentId == dept());
      allow create: if isAdmin() && validStudentCreate();
      allow update: if (isAdmin() && validStudentAdminUpdate())
                    || (isTeacher() && teacherAppliesRecitation(sid));
      allow delete: if isAdmin();
    }

    // ---------- recitations (append-only history) ----------
    function recitationKeys() {
      return ['studentId', 'studentName', 'teacherId', 'teacherName', 'departmentId', 'recitationDate',
              'recitationType', 'partNumber', 'surahNumber', 'evaluation', 'evaluationPoints',
              'extraPoints', 'totalPoints', 'createdBy', 'createdAt'];
    }

    function expectedPoints(evaluation) {
      let settings = get(docPath('evaluation_settings', 'default'));
      return settings != null && ('points' in settings.data) && (evaluation in settings.data.points)
        ? settings.data.points[evaluation]
        : defaultPoints()[evaluation];
    }

    function maxExtra() {
      let settings = get(docPath('evaluation_settings', 'default'));
      return settings != null && ('maxExtraPoints' in settings.data) ? settings.data.maxExtraPoints : 100;
    }

    function validPortion(r) {
      return (r.recitationType == 'juz'
                && r.partNumber is int && r.partNumber >= 1 && r.partNumber <= 30
                && r.get('surahNumber', null) == null)
          || (r.recitationType == 'surah'
                && r.surahNumber is int && r.surahNumber >= 1 && r.surahNumber <= 114
                && r.get('partNumber', null) == null);
    }

    function validRecitation(rid) {
      let r = incoming();
      let student = getAfter(docPath('students', r.studentId));
      return r.keys().hasOnly(recitationKeys())
        && r.keys().hasAll(['studentId', 'studentName', 'teacherId', 'teacherName', 'departmentId',
                            'recitationDate', 'recitationType', 'evaluation', 'evaluationPoints',
                            'extraPoints', 'totalPoints', 'createdBy', 'createdAt'])
        && r.teacherId == myTeacherId()
        && r.createdBy == request.auth.uid
        && r.departmentId == dept()
        && student != null
        && student.data.teacherId == myTeacherId()
        && student.data.departmentId == dept()
        && student.data.lastAppliedRecitationId == rid
        && r.studentName is string && r.studentName.size() <= 60
        && r.teacherName is string && r.teacherName.size() <= 60
        && validPortion(r)
        && r.evaluation in evaluationNames()
        && r.evaluationPoints is int && r.evaluationPoints == expectedPoints(r.evaluation)
        && r.extraPoints is int && r.extraPoints >= 0 && r.extraPoints <= maxExtra()
        && r.totalPoints == r.evaluationPoints + r.extraPoints
        && r.recitationDate is timestamp
        && r.recitationDate <= request.time + duration.value(1, 'd')
        && r.recitationDate >= request.time - duration.value(400, 'd')
        && r.createdAt == request.time;
    }

    match /recitations/{rid} {
      allow read: if isAdmin() || (isTeacher() && resource.data.departmentId == dept());
      allow create: if isTeacher() && validRecitation(rid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- settings ----------
    function validEvaluationSettings() {
      let s = incoming();
      let p = s.points;
      return s.keys().hasOnly(['points', 'maxExtraPoints', 'updatedAt'])
        && p is map && p.keys().hasOnly(evaluationNames()) && p.keys().hasAll(evaluationNames())
        && p.excellentPlus is int && p.excellentPlus >= 0 && p.excellentPlus <= 1000
        && p.excellent is int && p.excellent >= 0 && p.excellent <= 1000
        && p.veryGood is int && p.veryGood >= 0 && p.veryGood <= 1000
        && p.notRecited is int && p.notRecited >= 0 && p.notRecited <= 1000
        && p.repeat is int && p.repeat >= 0 && p.repeat <= 1000
        && s.maxExtraPoints is int && s.maxExtraPoints >= 0 && s.maxExtraPoints <= 1000;
    }

    match /evaluation_settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && id == 'default' && validEvaluationSettings();
    }

    match /app_settings/general {
      allow read: if signedIn();
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['academyName', 'milestoneStep', 'updatedAt'])
        && validName(incoming().academyName)
        && incoming().milestoneStep is int && incoming().milestoneStep >= 50;
    }

    // ---------- notifications ----------
    match /notifications/{nid} {
      allow read: if isAdmin()
        || (isTeacher() && (resource.data.audience == 'all'
                            || resource.data.audience == 'dept_' + dept()
                            || resource.data.get('userId', '') == myTeacherId()));
      // Admin announcements, or a teacher's own milestone (written with the recitation).
      allow create: if (isAdmin()
                        && incoming().keys().hasOnly(['title', 'body', 'audience', 'type', 'createdBy', 'createdAt'])
                        && incoming().audience in ['all', 'dept_male', 'dept_female']
                        && incoming().type == 'announcement'
                        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 80
                        && incoming().body is string && incoming().body.size() > 0 && incoming().body.size() <= 500
                        && incoming().createdBy == request.auth.uid
                        && incoming().createdAt == request.time)
                    || (isTeacher()
                        && incoming().keys().hasOnly(['title', 'body', 'audience', 'type', 'userId', 'studentId', 'createdBy', 'createdAt'])
                        && incoming().type == 'milestone'
                        && incoming().audience == 'user'
                        && incoming().userId == myTeacherId()
                        && incoming().title is string && incoming().title.size() <= 80
                        && incoming().body is string && incoming().body.size() <= 300
                        && incoming().createdBy == request.auth.uid
                        && incoming().createdAt == request.time);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
