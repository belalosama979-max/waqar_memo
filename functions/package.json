{
  "name": "alwaqar-backend-tools",
  "private": true,
  "description": "Local tooling for the Alwaqar Firebase backend (free Spark plan, no Cloud Functions): emulators, demo seed data, security-rules tests.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-alwaqar",
    "seed": "node scripts/seed-emulator.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-alwaqar \"node --test test/rules.test.js\"",
    "deploy": "firebase deploy --only firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.0.0"
  }
}